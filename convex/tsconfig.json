{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ES2023", "dom"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "allowJs": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["./**/*"],
    "exclude": ["./_generated"]
}
