{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext"],
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "types": ["bun"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [".github/scripts", "convex", "eslint.config.ts"]
}
