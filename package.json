{
    "name": "hara",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.3",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "bun run --filter './apps/*' build",
        "check": "bun run lint && bun run typecheck && bun run test",
        "dev": "bun run --filter @hara/console dev",
        "fix": "bun --bun eslint . --fix",
        "lint": "bun --bun eslint .",
        "test": "bun test . ./.github",
        "typecheck": "tsc && bun run --filter './apps/*' --filter './packages/*' typecheck"
    },
    "dependencies": {
        "@convex-dev/auth": "2.1.0",
        "@hara/accounts": "workspace:*",
        "@hara/email": "workspace:*",
        "convex": "1.51.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "6.0.1",
        "@types/bun": "1.4.5",
        "@types/node": "24.19.4",
        "eslint": "10.15.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.14.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.74.0"
    }
}
