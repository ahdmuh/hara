{
    "name": "hara",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.3",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "check": "bun run lint && bun run typecheck && bun run test",
        "fix": "bun --bun eslint . --fix",
        "lint": "bun --bun eslint .",
        "test": "bun test . ./.github",
        "typecheck": "tsc"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "6.0.1",
        "@types/bun": "1.4.5",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.74.0"
    }
}
